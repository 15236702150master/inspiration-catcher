PORT=4173
HOST=127.0.0.1
JOB_RETENTION_DAYS=30
JOB_RETENTION_COUNT=50
ADMIN_TOKEN=change-this-to-a-long-random-value
WORKER_TOKEN=change-this-to-a-separate-random-value
WECHAT_PROXY_URL=
MEDIA_PROXY_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
CLAUDE_MODEL=claude-3-5-haiku-latest
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1/chat/completions
XAI_MODEL=grok-3-mini
YUANBAO_COOKIE=
# 接入 Gaia Whisper medium 时配置为远程任务包装命令
TRANSCRIBE_COMMAND=
YTDLP_PATH=yt-dlp
YTDLP_WSL_PATH=yt-dlp

# Feishu sync. Server only needs an encryption key; each user fills their own
# Feishu App ID / App Secret in the website connection panel.
INTEGRATION_ENCRYPTION_KEY=
PUBLIC_BASE_URL=https://example.com
FEISHU_REDIRECT_URI=https://example.com/api/integrations/feishu/oauth/callback
FEISHU_PKCE_ENABLED=false
# Optional legacy fallback for old deployments that still use one shared app.
# Keep false for normal multi-user onboarding; old connected users can still
# finish migration while new users fill their own ID/Key in the website.
FEISHU_SERVER_APP_FALLBACK=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
